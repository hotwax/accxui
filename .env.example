# Copy to .env.local at the workspace root and fill in real values.
#
# One entry per dev server, keyed by its VITE_ALIAS label or its full URL.
# Every AccxUI app reads this list, so adding an app needs no credential setup.
#
# Only list servers you would type these credentials into yourself, and never a
# production instance. See docs/DEV_AUTO_LOGIN.md.
VITE_DEV_CREDENTIALS='{"local":{"username":"","password":""},"rails-oms":{"username":"","password":""}}'
