# Shared dev login settings for every app in apps/.
# Copy this file to .env (gitignored) in the accxui root and fill it in.
# Used only while `vite` serves an app (never by `vite build`); an app's own non-empty value wins.
# See docs/DEV_AUTO_LOGIN.md.

# OMS aliases offered under "Dev servers" on the login page, each with auto-login
VITE_ALIAS='{"local":"http://localhost:8080"}'
# OMS prefilled on the login page (an alias key or a URL)
VITE_DEFAULT_ALIAS=local

# Sent to every server in VITE_ALIAS; never list a production instance there
VITE_DEV_USERNAME=
VITE_DEV_PASSWORD=
